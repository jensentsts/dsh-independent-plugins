+// @vitest-environment jsdom
+/** Opt-in integration with a separately built decoration plugin; ordinary upstream runs have no dependency on it. */
+import React, { useState, type ReactNode } from 'react'
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import vm from 'node:vm'
+import { afterEach, expect, it, onTestFinished } from 'vitest'
+import { act, cleanup } from '@testing-library/react'
+import type { Plugin } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { SlotTestRuntime } from '@deepseek-ai/dsh-client-test-runtime'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { PropsRenderFactories, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { ChatMessageAppearanceInjected, ChatMessageOwner } from '../src/client/contract/message-chrome.ts'
+import type { InjectFace } from '@deepseek-ai/dsh-client-ui-slots'
+import { ChatChromeRegistry } from '../src/client/message-chrome.ts'
+import { MessageChrome } from '../src/client/chat/MessageChrome.tsx'
+
+const packageRoot = process.env.DSH_BUBBLE_TEST_PACKAGE
+afterEach(cleanup)
+
+function artifactPlugin(root: string): Plugin {
+  let plugin: Plugin | undefined
+  const artifact = readFileSync(resolve(root, 'lib/client.js'), 'utf8')
+  vm.runInNewContext(artifact, {
+    window: { __ModuleLoader__: { load(value: { factory: (require: (id: string) => typeof React) => Plugin }) {
+      plugin = value.factory((id) => {
+        if (id !== 'react') throw new Error(`Unexpected feature runtime dependency: ${id}`)
+        return React
+      })
+    } } }, document, console,
+  })
+  if (plugin === undefined) throw new Error('The built decoration artifact did not publish its plugin')
+  return plugin
+}
+
+type NativeProbeProps = PropsRuntime<'conversation.approval.detail'> & PropsRenderFactories & InjectFace<ChatMessageAppearanceInjected>
+const owner: ChatMessageOwner = {
+  contractVersion: 1, instanceKey: 'assistant:1:1:response', nodeKey: 'assistant:1:1',
+  kind: 'assistant-step', part: 'message', turn: 1, step: 1, gutter: { available: false, width: 0 },
+}
+function NativeProbe({ useChatChrome, renderFactorySlot }: NativeProbeProps) {
+  const appearance = useChatChrome(value => value.resolve(owner))
+  return <div data-native-probe data-message-variant={appearance.variant} className={appearance.className}>
+    {renderFactorySlot('conversation.chat.message.chrome', { owner })}
+    <button type="button">Native copy</button>
+    <p>Native reply</p>
+  </div>
+}
+
+it.skipIf(packageRoot === undefined)('mounts actual bubble header/avatar with recorded effort and unloads without replacing native controls', async () => {
+  if (packageRoot === undefined) throw new Error('DSH_BUBBLE_TEST_PACKAGE is required for this opt-in suite')
+  const runtime = await SlotTestRuntime.create()
+  onTestFinished(() => runtime.dispose())
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  locale.setLocale('en')
+  runtime.slots.installLocale(locale)
+  const chrome = new ChatChromeRegistry()
+  runtime.ctx.provide('uiChatChrome', chrome)
+  const config = createSnapshotStore({ status: 'ready', value: {
+    enabled: true, showTags: true, showNames: true, showAvatars: true,
+    avatarPlacement: 'auto', questionLayout: 'aggregate', members: [],
+  }, writable: true })
+  runtime.ctx.provide('configForms', { get: () => ({
+    getSnapshot: config.getSnapshot, subscribe: config.subscribe, set: async () => true,
+  }) } as never)
+  await runtime.sessions.add({ id: 'bubble-native' })
+  const session = runtime.sessions.retainFor(runtime.ctx, SessionId('bubble-native'))
+  await session.ready
+  await runtime.sessions.setProjection('bubble-native', 'bubbleConversation', {
+    version: 1, byMessageId: {}, byCallId: {}, byStep: {
+      '1:1': { provider: 'api', model: 'gpt-a', effort: 'high', effortOrigin: 'explicit', turn: 1, step: 1 },
+    },
+  })
+  await runtime.mount({ inject: ['slots'], apply(ctx) {
+    ctx.slots.registerFactory({ name: 'conversation.chat.message.chrome', scope: 'session', children: {
+      'conversation.chat.message.header': { kind: 'single', scope: 'session' },
+      'conversation.chat.message.avatar': { kind: 'single', scope: 'session' },
+    } }, MessageChrome)
+  } })
+  const captured: { props?: PropsRenderSlots<'conversation.approval.detail'>; set?: (value: ReactNode) => void } = {}
+  await runtime.root.declare({ 'conversation.approval.detail': { kind: 'single', scope: 'session' } }, function Root(props) {
+    const [value, set] = useState<ReactNode>(null)
+    captured.props = props
+    captured.set = set
+    return value
+  })
+  await runtime.mount({ inject: ['slots'], apply(ctx) {
+    ctx.slots.register({ name: 'conversation.approval.detail', inject: () => ({ hooks: { chatChrome: chrome.appearances } }) }, NativeProbe)
+  } })
+  const view = runtime.renderRoot()
+  const { props, set } = captured
+  if (props === undefined || set === undefined) throw new Error('Native integration root did not render')
+  const SessionProvider = props.SessionProvider
+  act(() => { set(<SessionProvider session={session}>{props.renderSlot('conversation.approval.detail', {})}</SessionProvider>) })
+  const nativeReply = view.getByText('Native reply')
+  const copy = view.getByRole('button', { name: 'Native copy' })
+  const bubble = await runtime.mount(artifactPlugin(packageRoot))
+  expect(view.getByText('gpt-a:high')).toBeTruthy()
+  const avatar = view.getByRole('img')
+  expect(avatar.closest('[data-message-chrome]')).toBe(view.getByText('gpt-a:high').closest('[data-message-chrome]'))
+  expect(avatar.closest('[data-native-probe]')).toBe(nativeReply.parentElement)
+  expect(view.getByRole('button', { name: 'Native copy' })).toBe(copy)
+  expect(view.getByText('Native reply')).toBe(nativeReply)
+  expect(nativeReply.parentElement?.getAttribute('data-message-variant')).toBe('bubble')
+  await bubble.dispose()
+  expect(view.queryByRole('img')).toBeNull()
+  expect(view.queryByText('gpt-a:high')).toBeNull()
+  expect(view.getByRole('button', { name: 'Native copy' })).toBe(copy)
+  expect(view.getByText('Native reply')).toBe(nativeReply)
+  expect(nativeReply.parentElement?.getAttribute('data-message-variant')).toBe('native')
+  expect(document.querySelector('style[data-plugin="dsh-bubble-conversation"]')).toBeNull()
+})
