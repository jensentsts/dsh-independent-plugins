--- /dev/null
+++ b/packages/api/session-controller/tests/preview.fixture.ts
@@ -0,0 +1,82 @@
+/** Scripted external Host answers over production RemoteStream transport. */
+import { vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { RemoteStream, type RemoteStreamOptions } from '@deepseek-ai/dsh-api-gateway/client'
+import { streamHandle } from '@deepseek-ai/dsh-remote-mock'
+import { SESSION_FORMAT_VERSION } from '@deepseek-ai/dsh-session/types'
+import type { SessionEvent } from '@deepseek-ai/dsh-session/types'
+import type { RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import type { SessionRemote } from '../src/client/transport.ts'
+import type { SessionRemotes } from '../src/client/sessions/remotes.ts'
+import type { SessionEventsPage, SessionFollowFrame, SessionFollowRequest, SessionPageRequest } from '../src/types.ts'
+
+/** Only Host answers are scripted; journal ordering, retry, and disposal remain production code. */
+export function previewRemote() {
+  const generation = createSnapshotStore({ id: 1, host: { home: '/fixture' } })
+  const followRequests: SessionFollowRequest[] = []
+  const pageRequests: SessionPageRequest[] = []
+  const signals: AbortSignal[] = []
+  const feeds = new Set<(frame: SessionFollowFrame | 'disconnect') => void>()
+  let opening: SessionEventsPage | Promise<SessionEventsPage> = { cursor: -1, records: [], hasMore: false }
+  let openingFailure: Error | undefined
+  let opened = 0
+  let closed = 0
+  const follow = vi.fn((request: SessionFollowRequest, signal = new AbortController().signal) => {
+    followRequests.push(request)
+    signals.push(signal)
+    return streamHandle((async function* () {
+      const frames: (SessionFollowFrame | 'disconnect')[] = []
+      let wake = (): void => {}
+      const push = (frame: SessionFollowFrame | 'disconnect'): void => { frames.push(frame); wake() }
+      const aborted = (): void => { wake() }
+      feeds.add(push)
+      signal.addEventListener('abort', aborted, { once: true })
+      opened++
+      try {
+        const page = await opening
+        if (signal.aborted) return
+        if (openingFailure !== undefined) throw openingFailure
+        yield {
+          type: 'snapshot',
+          header: { version: SESSION_FORMAT_VERSION, id: request.address.kind === 'session' ? request.address.sessionId : request.address.childSessionId, createdAt: 0, isSeeded: false },
+          ...page, projections: { asOfSeq: page.cursor, values: {} }, assistantStream: { revision: 0 },
+        } satisfies SessionFollowFrame
+        while (!signal.aborted) {
+          if (frames.length === 0) await new Promise<void>(resolve => { wake = resolve })
+          const frame = frames.shift()
+          if (frame === 'disconnect') return
+          if (!signal.aborted && frame !== undefined) yield frame
+        }
+      } finally {
+        closed++
+        feeds.delete(push)
+        signal.removeEventListener('abort', aborted)
+      }
+    })())
+  })
+  const page = vi.fn(async (request: SessionPageRequest): Promise<RemoteResult<SessionEventsPage>> => {
+    pageRequests.push(request)
+    return { ok: true, value: { cursor: request.throughSeq ?? -1, records: [], hasMore: false } }
+  })
+  const attachment = vi.fn<SessionRemote['attachment']>(async request => ({ ok: true, value: { attachment: request.attachment, data: 'AA==' } }))
+  const list = vi.fn<SessionRemote['list']>(async () => ({ ok: true, value: { items: [] } }))
+  const write = vi.fn(async () => { throw new Error('preview must not send a write') })
+  const session = {
+    follow, page, attachment, list, prompt: write, cancel: write, rename: write, updateQueue: write,
+    create: write, fork: write, selectModel: write,
+  } as SessionRemote
+  const remote: SessionRemotes = {
+    session,
+    $stream: <Item>(options: RemoteStreamOptions<Item>) => new RemoteStream({ generation }, options),
+    commands: { execute: write }, subagents: { prompt: write, interruptByParent: write },
+  }
+  return {
+    remote, generation, follow, page, attachment, list, write, followRequests, pageRequests, signals,
+    setOpening(value: SessionEventsPage | Promise<SessionEventsPage>) { opening = value },
+    failOpening(error: Error) { openingFailure = error },
+    disconnect() { for (const feed of feeds) feed('disconnect') },
+    pushFrame(frame: SessionFollowFrame) { for (const feed of feeds) feed(frame) },
+    push(event: SessionEvent) { for (const feed of feeds) feed({ type: 'event', event }) },
+    get opened() { return opened }, get closed() { return closed },
+  }
+}
