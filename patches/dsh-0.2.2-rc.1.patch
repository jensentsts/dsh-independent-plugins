+/** Presentation marker attached by a transport to a native next-step input. */
+export function isExternalSteeringSource(source: unknown): boolean {
+  return source !== null && typeof source === 'object'
+    && 'kind' in source && typeof source.kind === 'string' && source.kind !== 'user'
+    && 'inputMode' in source && source.inputMode === 'steer'
+}
diff --git a/packages/client/ui-chat/src/client/message-chrome.ts b/packages/client/ui-chat/src/client/message-chrome.ts
new file mode 100644
index 00000000..c39f5a46
--- /dev/null
+++ b/packages/client/ui-chat/src/client/message-chrome.ts
@@ -0,0 +1,65 @@
+/** Effect-owned appearance election; body rendering is not a registry operation. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type {
+  ChatMessageAppearance, ChatMessageAppearanceRegistration, ChatMessageAppearanceSnapshot, ChatMessageOwner, UiChatChrome,
+} from './contract/message-chrome.ts'
+import css from './chat/MessageFrame.module.css'
+
+const NATIVE: ChatMessageAppearance = Object.freeze({ variant: 'native' })
+const TRANSPARENT: ChatMessageAppearance = Object.freeze({ variant: 'transparent' })
+
+/** Internal provider; the public browser entry exposes only its interface. */
+export class ChatChromeRegistry implements UiChatChrome {
+  readonly contractVersion = 1
+  readonly avatarPlacementVersion = 1
+  private readonly entries = new Map<string, ChatMessageAppearanceRegistration>()
+  readonly appearances = createSnapshotStore<ChatMessageAppearanceSnapshot>({ resolve: owner =>
+    owner.part === 'control' || owner.part === 'container' ? TRANSPARENT : NATIVE })
+
+  registerAppearance(registration: ChatMessageAppearanceRegistration): () => void {
+    if (this.entries.has(registration.id)) throw new Error(`ui-chat: duplicate appearance '${registration.id}'`)
+    const entry = { ...registration }
+    this.entries.set(registration.id, entry)
+    this.publish()
+    let active = true
+    return () => {
+      if (!active) return
+      active = false
+      if (this.entries.get(registration.id) !== entry) return
+      this.entries.delete(registration.id)
+      this.publish()
+    }
+  }
+
+  /** Retire every contribution when the owning ui-chat plugin unloads. */
+  dispose(): void {
+    this.entries.clear()
+    this.publish()
+  }
+
+  private publish(): void {
+    const entries = [...this.entries.values()].sort((a, b) => (a.priority ?? 100) - (b.priority ?? 100))
+    const cache = new WeakMap<ChatMessageOwner, ChatMessageAppearance>()
+    this.appearances.set({ resolve: (owner) => {
+      if (owner.part === 'control' || owner.part === 'container') return TRANSPARENT
+      const cached = cache.get(owner)
+      if (cached !== undefined) return cached
+      let appearance = NATIVE
+      for (const entry of entries) {
+        let selected: ChatMessageAppearance | null
+        try { selected = entry.select(owner) }
+        catch (error: unknown) {
+          console.error(`[ui-chat] appearance '${entry.id}' failed; retaining native content`, error)
+          continue
+        }
+        if (selected === null) continue
+        appearance = selected.variant === 'bubble'
+          ? { ...selected, className: [css.frame, css.bubble, selected.className].filter(Boolean).join(' ') }
+          : selected
+        break
+      }
+      cache.set(owner, appearance)
+      return appearance
+    } })
+  }
+}
diff --git a/packages/client/ui-chat/src/client/preview/policy.ts b/packages/client/ui-chat/src/client/preview/policy.ts
