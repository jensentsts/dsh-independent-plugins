+/** Shared view-only preference consumed by native question transcript renderers. */
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+
+/** Group a recorded batch into one box or one box per stable question id. */
+export type QuestionPresentationMode = 'aggregate' | 'individual'
+
+/** Selected view data; question content and answer channels are not part of it. */
+export interface QuestionPresentation {
+  readonly mode: QuestionPresentationMode
+}
+
+/** Effect-owned global presentation choice contributed by an independent plugin. */
+export interface QuestionPresentationRegistration {
+  readonly id: string
+  /** Lower ranks select first; omission uses 100, and ties retain registration order. */
+  readonly priority?: number
+  readonly mode: QuestionPresentationMode
+}
+
+/** Optional presentation provider implemented by the native user-question plugin. */
+export interface UiQuestionPresentation {
+  readonly contractVersion: 1
+  /** Bare apply-world source; renderers receive its framework-created selector hook. */
+  readonly presentation: ObservableSnapshot<QuestionPresentation>
+  /**
+   * Register a view preference without receiving question bodies or settlement verbs.
+   * @param registration - contributor identity, rank, and display mode.
+   * @returns idempotent disposer; the contributor registers it through its Context's effect.
+   */
+  registerPresentation(registration: QuestionPresentationRegistration): () => void
+}
+
+/** Apply-world source bound to useQuestionPresentation by the Slot renderer. */
+export interface QuestionPresentationInjected {
+  readonly hooks: { readonly questionPresentation: ObservableSnapshot<QuestionPresentation> }
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Optional view-only user-question presentation; absence preserves aggregated native boxes. */
+    uiQuestionPresentation: UiQuestionPresentation
+  }
+}
