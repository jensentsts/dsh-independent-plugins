@@ -0,0 +1,28 @@
+/** Optional question view preference bridged once in the Tool plugin's apply lifetime. */
+import type { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { QuestionPresentation } from './contract/question-presentation.ts'
+
+/**
+ * Keep the toolview's source stable while the optional question UI enters or leaves.
+ * @param ctx - owning Tool plugin context.
+ * @returns one bare source with aggregated native boxes when no provider is present.
+ */
+export function bindQuestionPresentation(ctx: Context): ObservableSnapshot<QuestionPresentation> {
+  const source = createSnapshotStore<QuestionPresentation>({ mode: 'aggregate' })
+  const publish = (value: QuestionPresentation): void => {
+    if (source.getSnapshot().mode !== value.mode) source.set({ mode: value.mode })
+  }
+  ctx.inject(['uiQuestionPresentation'], child => child.effect(() => {
+    const presentation = child.uiQuestionPresentation.presentation
+    const sync = (): void => { publish(presentation.getSnapshot()) }
+    const stop = presentation.subscribe(sync)
+    sync()
+    return () => {
+      stop()
+      publish({ mode: 'aggregate' })
+    }
+  }, 'ui-tool: optional question presentation'))
+  return source
+}
diff --git a/packages/client/ui-tool/src/client/tool/models/file-card-model.ts b/packages/client/ui-tool/src/client/tool/models/file-card-model.ts
