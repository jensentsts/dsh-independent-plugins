@@ -0,0 +1,36 @@
+/** Native occurrence identity derived only from the current node, never from a history scan. */
+import type { ChatNode } from '../contract/chat-nodes.ts'
+import type { ChatMessageOwner } from '../contract/message-chrome.ts'
+
+/**
+ * Describe one current node wrapper without scanning neighbouring nodes or history.
+ * @param node - currently rendered keyed node.
+ * @param instanceKey - existing flow identity, including its selected part.
+ * @param groupPart - renderer-owned portion, when grouping split the node.
+ * @returns identity for optional chrome and appearance selection.
+ */
+export function nodeMessageOwner(node: ChatNode, instanceKey: string, groupPart?: string): ChatMessageOwner {
+  const location = node.location
+  const data: unknown = node.data
+  // Other Chat definitions may supply any payload, including null or a scalar.
+  const fields = typeof data === 'object' && data !== null ? data : undefined
+  const messageId = node.kind === 'assistant-step' ? node.data.finalNode?.messageId
+    : fields !== undefined && 'messageId' in fields && typeof fields.messageId === 'string' ? fields.messageId : undefined
+  const source = fields !== undefined && 'source' in fields ? fields.source : undefined
+  const reasoningContainer = node.kind === 'assistant-step' && groupPart !== 'response'
+  const turn = node.kind === 'assistant-step' ? node.data.turn
+    : location.kind === 'turn' || location.kind === 'step' ? location.turn.turn : undefined
+  const step = node.kind === 'assistant-step' ? node.data.step
+    : location.kind === 'step' ? location.step.step : undefined
+  const part = node.kind === 'turn-tail' || node.kind === 'turn-process' ? 'control'
+    : node.kind === 'tool-call' || reasoningContainer ? 'container' : 'message'
+  return {
+    contractVersion: 1, instanceKey, nodeKey: node.key, kind: node.kind, part,
+    ...(groupPart === undefined ? {} : { groupPart }),
+    ...(turn === undefined ? {} : { turn }),
+    ...(step === undefined ? {} : { step }),
+    ...(messageId === undefined ? {} : { messageId }),
+    ...(source === undefined ? {} : { source }),
+    gutter: { available: false, width: 0 },
+  }
+}
diff --git a/packages/client/ui-chat/src/client/contract/message-chrome.ts b/packages/client/ui-chat/src/client/contract/message-chrome.ts
