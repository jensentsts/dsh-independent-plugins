+/** Public input and private operations for an independently owned native preview occurrence. */
+import type { FactoryComponentPropsOf } from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionPreviewTarget } from '@deepseek-ai/dsh-client-ui-session/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** A native historical read, not a main-view navigation or retained interactive Session. */
+export interface ConversationPreviewInput {
+  readonly sessionId: SessionId
+  readonly readOnly: true
+}
+
+/** Operations installed by the preview owner; components never receive its reader or context. */
+export interface ConversationPreviewInjected {
+  /** @param sessionId - durable Session id. @returns an opaque local occurrence identity. */
+  openPreview(sessionId: SessionId): { readonly id: number; readonly target: SessionPreviewTarget }
+  /** @param id - local occurrence identity. Teardown joins all passive reads. */
+  closePreview(id: number): Promise<void>
+}
+
+/** Public root Factory props. */
+export type ConversationPreviewProps = FactoryComponentPropsOf<'conversation.preview'>
