+/** Immutable activation policy through the production RemoteStream and journal adapter. */
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { SessionEventStream } from '../src/client/transport.ts'
+import { Session } from '../src/client/sessions/session.ts'
+import { previewRemote } from './preview.fixture.ts'
+
+const ID = SessionId('preview-transport')
+
+describe('Session journal activation policy', () => {
+  for (const activate of [true, false] as const) {
+    it(`keeps activate:${String(activate)} through a physical source restart`, async () => {
+      const fixture = previewRemote()
+      const stream = new SessionEventStream(fixture.remote, { kind: 'session', sessionId: ID }, {
+        publish: () => {}, failed: error => { throw error },
+      }, activate)
+      onTestFinished(() => stream.dispose())
+      await stream.open({ maxMessages: 50 })
+      stream.restart()
+      await vi.waitFor(() => { expect(fixture.followRequests).toHaveLength(2) })
+      expect(fixture.followRequests.every(request => request.activate === activate && request.assistantStream === true)).toBe(true)
+      await stream.dispose()
+      expect(fixture.closed).toBe(fixture.opened)
+    })
+  }
+
+  it('preserves interactive activation when callers omit the new parameter', async () => {
+    const fixture = previewRemote()
+    const session = new Session(ID, fixture.remote)
+    onTestFinished(() => session.dispose())
+    await session.open()
+    expect(fixture.followRequests[0]).toMatchObject({ activate: true, assistantStream: true })
+    expect(fixture.write).not.toHaveBeenCalled()
+  })
+})
