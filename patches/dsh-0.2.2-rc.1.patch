+/** Identity-only Factory; the native message body is never an input. */
+import type { ChatMessageChromeFactoryProps } from '../contract/message-chrome.ts'
+import { isExternalSteeringSource } from '../external-steering.ts'
+import css from './MessageFrame.module.css'
+
+/**
+ * Render optional identity above an unchanged native body outlet.
+ * @param props - native occurrence and authorized header/avatar render seats.
+ * @returns header and avatar, or no chrome for native control/container rows.
+ */
+export function MessageChrome({ owner, renderSlot, useChatChrome, t }: ChatMessageChromeFactoryProps) {
+  const resolveAppearance = useChatChrome(snapshot => snapshot.resolve)
+  const appearance = resolveAppearance(owner)
+  const avatarPlacement = owner.part === 'reasoning' || owner.part === 'tool' ? 'header' : appearance.avatarPlacement ?? 'header'
+  if (owner.part === 'container' || owner.part === 'control') return null
+  const externalSteering = owner.kind === 'steering' && isExternalSteeringSource(owner.source)
+  return (
+    <div className={css.chrome} data-message-chrome={owner.instanceKey}
+      data-avatar-placement={avatarPlacement} data-message-align={appearance.align ?? (externalSteering ? 'end' : 'start')}
+      data-external-steering={externalSteering ? owner.pending ? 'pending' : 'admitted' : undefined}>
+      <div className={css.avatar}>{renderSlot('conversation.chat.message.avatar', { owner })}</div>
+      <div className={css.header}>{renderSlot('conversation.chat.message.header', { owner })}</div>
+      {externalSteering && <span className={css.steeringLabel}>{t('message.steering.external')}</span>}
+      {externalSteering && owner.pending && <span className={css.steeringPending}>{t('message.steering.pending')}</span>}
+    </div>
+  )
+}
