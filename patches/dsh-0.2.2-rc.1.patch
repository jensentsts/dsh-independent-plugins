+/** Independently owned passive Session reads for reusable transcript previews. */
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import type { SessionEventSource } from './events.ts'
+import type { ProjectionsFace } from './session.ts'
+import type { SessionSnapshot } from './snapshot.ts'
+
+/** Read capabilities of one preview; no Agent command or input operation is present. */
+export interface SessionPreviewFace extends ObservableSnapshot<SessionSnapshot> {
+  readonly sessionId: SessionId
+  readonly projections: ProjectionsFace
+  /** @returns after one Turn-aligned older page settles or the read fails without replacing the current window. */
+  loadOlder(): Promise<void>
+  /**
+   * Page backwards through a durable sequence without activating the Session.
+   * @param seq - inclusive durable sequence to cover.
+   * @returns after the window covers the sequence, history is exhausted, or the read fails.
+   */
+  loadThrough(seq: SessionSeq): Promise<void>
+  /**
+   * Read an authorized durable image without adopting its bytes or any browser URL.
+   * @param attachment - complete reference carried by the Session log.
+   * @returns borrowed read-only bytes and verified reference, or the Remote failure.
+   */
+  readAttachment(attachment: ImageAttachmentRef): Promise<RemoteResult<{ attachment: ImageAttachmentRef; data: Uint8Array }>>
+}
+
+/** Read sources of one independent preview generation, never a main Session binding. */
+export interface SessionPreviewBinding {
+  readonly sessionId: SessionId
+  readonly session: SessionPreviewFace
+  readonly eventSource: SessionEventSource
+}
+
+/** One caller-owned preview, including opening, paging, image reads, and stream teardown. */
+export interface SessionPreviewLease extends AsyncDisposable {
+  readonly sessionId: SessionId
+  /** Aborts synchronously when release begins; consumers use it to withdraw borrowed sources. */
+  readonly signal: AbortSignal
+  /** Borrowed sources; access throws after release begins. */
+  readonly binding: SessionPreviewBinding
+  /** Resolves after opening settles, including snapshot-reported failures; rejects on release or thrown failure. */
+  readonly ready: Promise<SessionPreviewBinding>
+  /** Settles when release finishes and no owned read or publication can continue. */
+  readonly closed: Promise<void>
+  /** @returns the same teardown Promise on every call; never cancels a Host Agent or another preview. */
+  release(): Promise<void>
+}
+
+/** Client service owning independent passive preview generations. */
+export interface ISessionPreviews {
+  /**
+   * Start an isolated read generation without retaining a main binding or activating a Host Agent.
+   * @param sessionId - ordinary Session identity; the Host validates existence and access.
+   * @param options - optional lifetime signal; omission leaves release to the caller or service disposal.
+   * @returns an immediately owned lease; two calls for one identity never share mutable view sources.
+   * @throws when the service is disposed or the supplied signal is already aborted.
+   */
+  open(sessionId: SessionId, options?: { readonly signal?: AbortSignal }): SessionPreviewLease
+}
