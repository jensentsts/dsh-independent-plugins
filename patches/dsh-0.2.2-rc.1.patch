+import type { FileAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import { fileExtension, FileTypeIcon, fileSizeText } from '@deepseek-ai/dsh-client-ui-primitives'
+import css from './MessageItem.module.css'
+
+/**
+ * One durable file reference as the native conversation file card.
+ * The card carries only the persisted name and byte count; the player for a
+ * supported media type renders through the position's own `file-media` slot.
+ * @param props.file - durable file reference from the Session log.
+ * @returns the shared file card used by user and Assistant content.
+ */
+export function FileAttachmentCard({ file }: { file: FileAttachmentRef }) {
+  return (
+    <span className={css.fileCard} title={file.name}>
+      <FileTypeIcon path={file.name} className={css.fileIcon} />
+      <span className={css.fileContent}>
+        <span className={css.fileName}>{file.name}</span>
+        <span className={css.fileMeta}>
+          {[fileExtension(file.name).toUpperCase().slice(0, 8), fileSizeText(file.bytes)]
+            .filter(Boolean).join(' ')}
+        </span>
+      </span>
+    </span>
+  )
+}
