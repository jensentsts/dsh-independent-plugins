index 00000000..2a7b2cf2
--- /dev/null
+++ b/packages/client/ui-tool/src/client/tool/models/file-card-model.ts
@@ -0,0 +1,82 @@
+/** Pure file-card derivation from raw Tool result content. @module */
+import type { AttachmentId, FileAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import type { ToolCallBlock } from './tool-call-model.ts'
+
+/**
+ * The durable file references one settled call contributes. The references
+ * come from the result's own `file` blocks: the content is what the tool
+ * returned and what a post-execute hook would replace with the rest of it.
+ */
+export interface FileCardModel {
+  /** The durable files this result returned, in result order. */
+  files: readonly { readonly attachment: FileAttachmentRef }[]
+  /** Text blocks outside the file card, joined in order; null when there are none. */
+  extraText: string | null
+}
+
+/**
+ * Narrow every durable file reference carried by the result's file blocks.
+ * Every field arrives unvalidated on replay, so one malformed block declines
+ * the whole card to the generic flattened output.
+ * @param content - the settled result's content blocks.
+ * @returns the narrowed references, or null when no valid file block is present.
+ */
+function fileReferences(content: readonly unknown[]): FileAttachmentRef[] | null {
+  const refs: FileAttachmentRef[] = []
+  for (const part of content) {
+    if (typeof part !== 'object' || part === null) continue
+    const { type, attachment } = part as { type?: unknown; attachment?: unknown }
+    if (type !== 'file') continue
+    if (typeof attachment !== 'object' || attachment === null || Array.isArray(attachment)) return null
+    const { attachmentId, name, bytes } = attachment as Record<string, unknown>
+    if (typeof attachmentId !== 'string' || attachmentId === '') return null
+    if (typeof name !== 'string' || name === '') return null
+    if (typeof bytes !== 'number' || !Number.isInteger(bytes) || bytes < 0) return null
+    refs.push({ attachmentId: attachmentId as AttachmentId, name, bytes })
+  }
+  return refs.length > 0 ? refs : null
+}
+
+/**
+ * Whether the content carries only blocks this card consumes. A merge-extensible
+ * block type the card cannot render must stay visible in the generic flattened
+ * output instead of being hidden behind a file card.
+ * @param content - the settled result's content blocks.
+ * @returns true when every block is a text or file object with usable fields.
+ */
+function fullyRendered(content: readonly unknown[]): boolean {
+  return content.every((part) => {
+    if (typeof part !== 'object' || part === null) return false
+    const { type, text } = part as { type?: unknown; text?: unknown }
+    return type === 'file' || (type === 'text' && typeof text === 'string')
+  })
+}
+
+/**
+ * Join the text blocks that sit beside the file references.
+ * @param content - the settled result's text blocks.
+ * @returns the joined text, or null when there is none.
+ */
+function extraTexts(content: readonly { type: string; text?: string }[]): string | null {
+  const parts = content.flatMap(part => part.type === 'text' && typeof part.text === 'string' ? [part.text] : [])
+  return parts.length > 0 ? parts.join('\n') : null
+}
+
+/**
+ * Derive a settled file card from the result's durable file blocks.
+ * The card is result-side only and declines whenever another block type would
+ * otherwise be hidden. The Tool layer owns no playback; the parent-owned
+ * `tool.call.file-media` position appends presentation after this card.
+ * @param block - running or settled Tool block.
+ * @returns the file-card props, or null for the generic path.
+ */
+export function fileCardModel(block: ToolCallBlock): FileCardModel | null {
+  if (!('kind' in block) || block.isError) return null
+  if (!fullyRendered(block.content)) return null
+  const refs = fileReferences(block.content)
+  if (refs === null) return null
+  return {
+    files: refs.map(ref => ({ attachment: ref })),
+    extraText: extraTexts(block.content),
+  }
+}
