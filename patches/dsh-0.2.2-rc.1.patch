+/** Native preview owner; its mounted occurrence is the sole owner of its passive read lease. */
+import { useEffect, useState } from 'react'
+import type { ConversationPreviewProps } from './contract.ts'
+
+/** @param props - root Factory input and owner-side lifetime callbacks. @returns native header and body in an isolated read scope. */
+export function ConversationPreview({ sessionId, readOnly, openPreview, closePreview, SessionProvider, renderSlot }: ConversationPreviewProps) {
+  const [occurrence, setOccurrence] = useState<ReturnType<typeof openPreview>>()
+  useEffect(() => {
+    const next = openPreview(sessionId)
+    setOccurrence(next)
+    return () => { void closePreview(next.id) }
+  }, [sessionId, openPreview, closePreview])
+  if (readOnly !== true || occurrence === undefined || occurrence.target.sessionId !== sessionId) return null
+  return <SessionProvider session={occurrence.target}>{renderSlot('conversation.preview.body', {})}</SessionProvider>
+}
+
+/** @param props - strict read scope and Factory renderer. @returns the same native header and Chat body definitions. */
+export function ConversationPreviewBody({ renderFactorySlot }: import('@deepseek-ai/dsh-client-ui-slots').PropsRuntime<'conversation.preview.body'> & import('@deepseek-ai/dsh-client-ui-slots').PropsRenderFactories) {
+  return <div style={{ display: 'flex', flexDirection: 'column', minHeight: 0, height: '100%' }} data-conversation-preview="">
+    {renderFactorySlot('conversation.session.header.content', { hideChrome: false, selectedView: 'chat' })}
+    {renderFactorySlot('conversation.chat.body', { inspectCall: undefined, viewRequest: null })}
+  </div>
+}
