index 00000000..4adbac8d
--- /dev/null
+++ b/packages/client/ui-chat/src/client/preview/policy.ts
@@ -0,0 +1,40 @@
+/** Read-only Chat actions and privately owned media; no interactive Session is retained. */
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import type { SessionPreviewBinding } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { MessageImageLoader } from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+/** @param readOnly - historical view mode, not an access-policy result. @returns denial before a write callback can run. */
+export function requireInteractive(readOnly: boolean | undefined): void {
+  if (readOnly === true) throw new Error('This native preview supports historical reads only')
+}
+
+/** @param binding - passive reader. @param signal - preview lifetime. @returns a private media loader and non-owning synchronous peek. */
+export function previewImageLoader(binding: SessionPreviewBinding, signal: AbortSignal): MessageImageLoader {
+  const cache = new Map<string, { readonly pending: Promise<string>; current?: string }>()
+  signal.addEventListener('abort', () => {
+    for (const entry of cache.values()) if (entry.current?.startsWith('blob:')) URL.revokeObjectURL(entry.current)
+    cache.clear()
+  }, { once: true })
+  const load: MessageImageLoader = attachment => {
+    signal.throwIfAborted()
+    const key = attachment.attachmentId
+    const existing = cache.get(key)
+    if (existing !== undefined) return existing.pending
+    const entry: { readonly pending: Promise<string>; current?: string } = {
+      pending: binding.session.readAttachment(attachment).then(result => {
+        signal.throwIfAborted()
+        if (!result.ok) throw new Error(`${result.error.code}: ${result.error.message}`)
+        const bytes = Uint8Array.from(result.value.data)
+        const url = typeof URL.createObjectURL === 'function'
+          ? URL.createObjectURL(new Blob([bytes.buffer], { type: result.value.attachment.mediaType }))
+          : `data:${result.value.attachment.mediaType};base64,${btoa(Array.from(bytes, byte => String.fromCharCode(byte)).join(''))}`
+        entry.current = url
+        return url
+      }),
+    }
+    cache.set(key, entry)
+    return entry.pending
+  }
+  load.peek = (attachment: ImageAttachmentRef) => cache.get(attachment.attachmentId)?.current
+  return load
+}
