+// @vitest-environment jsdom
+/** Optional presentation providers do not own native tool-card content or disclosure. */
+import { afterEach, expect, it } from 'vitest'
+import { act, cleanup, render } from '@testing-library/react'
+import { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-test-runtime'
+import type { QuestionPresentation, UiQuestionPresentation } from '../src/client/contract/question-presentation.ts'
+import { bindQuestionPresentation } from '../src/client/question-presentation.ts'
+import { AskQuestionCard } from '../src/client/tool/components/AskQuestionCard.tsx'
+
+afterEach(cleanup)
+
+it('follows an optional provider through replacement and restores native boxes without replacing Q/A nodes', async () => {
+  const ctx = new Context()
+  const source = bindQuestionPresentation(ctx)
+  const useQuestionPresentation = bindSnapshotSelector(source)
+  function Card() {
+    const mode = useQuestionPresentation(value => value.mode)
+    return <AskQuestionCard mode={mode} card={{ kind: 'answered', skippedLabel: 'Skipped', questions: [
+      { id: 'a', question: 'First?', answers: ['Yes'] },
+      { id: 'b', question: 'Approve?', answers: [] },
+    ] }} />
+  }
+  const view = render(<Card />)
+  const question = view.getByText('First?')
+  const answer = view.getByText('Yes')
+  const skipped = view.getByText('Skipped')
+  const items = [...view.container.querySelectorAll('[data-question-id]')]
+  expect(view.container.querySelector('[data-question-presentation]')?.getAttribute('data-question-presentation')).toBe('aggregate')
+  const presentation = createSnapshotStore<QuestionPresentation>({ mode: 'individual' })
+  const provider: UiQuestionPresentation = {
+    contractVersion: 1, presentation,
+    registerPresentation: () => () => {},
+  }
+  const fiber = ctx.plugin({ apply(child) { child.provide('uiQuestionPresentation', provider) } })
+  await act(async () => { await fiber.await(); await Promise.resolve() })
+  expect(view.container.querySelector('[data-question-presentation]')?.getAttribute('data-question-presentation')).toBe('individual')
+  expect(source.getSnapshot()).toEqual({ mode: 'individual' })
+  act(() => { presentation.set({ mode: 'aggregate' }) })
+  expect(source.getSnapshot()).toEqual({ mode: 'aggregate' })
+  act(() => { presentation.set({ mode: 'individual' }) })
+  await act(async () => { await fiber.dispose(); await Promise.resolve() })
+  expect(source.getSnapshot()).toEqual({ mode: 'aggregate' })
+  expect([...view.container.querySelectorAll('[data-question-id]')]).toEqual(items)
+  expect(view.getByText('First?')).toBe(question)
+  expect(view.getByText('Yes')).toBe(answer)
+  expect(view.getByText('Skipped')).toBe(skipped)
+  await ctx.fiber.dispose()
+})
+
+it('keeps unanswered question ids and the native verdict when individually boxed', () => {
+  const view = render(<AskQuestionCard mode="individual" card={{ kind: 'unanswered', verdict: 'Cancelled', questions: [
+    { id: 'a', question: 'First?' }, { id: 'b', question: 'Second?' },
+  ] }} />)
+  expect(view.getByText('Cancelled')).toBeTruthy()
+  expect([...view.container.querySelectorAll('[data-question-id]')].map(item => item.getAttribute('data-question-id'))).toEqual(['a', 'b'])
+  expect(view.getAllByRole('listitem')).toHaveLength(2)
+})
