+++ b/packages/client/ui-user-questions/tests/question-presentation.client.spec.ts
@@ -0,0 +1,46 @@
+/** View preference election changes no question content or answer lifetime. */
+import { describe, expect, it, vi } from 'vitest'
+import { QuestionPresentationRegistry } from '../src/client/question-presentation.ts'
+
+describe('question presentation registry', () => {
+  it('defaults to aggregate and publishes only when the selected mode changes', () => {
+    const registry = new QuestionPresentationRegistry()
+    expect(registry.contractVersion).toBe(1)
+    const source = registry.presentation
+    const original = source.getSnapshot()
+    const changed = vi.fn()
+    const stop = source.subscribe(changed)
+    const removeDefault = registry.registerPresentation({ id: 'native', mode: 'aggregate' })
+    expect(source.getSnapshot()).toBe(original)
+    expect(changed).not.toHaveBeenCalled()
+    const removeLow = registry.registerPresentation({ id: 'low', mode: 'individual', priority: 200 })
+    expect(source.getSnapshot()).toBe(original)
+    const removeHigh = registry.registerPresentation({ id: 'high', mode: 'individual', priority: 0 })
+    expect(source.getSnapshot()).toEqual({ mode: 'individual' })
+    expect(changed).toHaveBeenCalledOnce()
+    removeHigh()
+    expect(source.getSnapshot()).toEqual({ mode: 'aggregate' })
+    removeDefault()
+    expect(source.getSnapshot()).toEqual({ mode: 'individual' })
+    removeLow()
+    expect(source.getSnapshot()).toEqual({ mode: 'aggregate' })
+    expect(registry.presentation).toBe(source)
+    stop()
+  })
+
+  it('keeps tie insertion order, rejects duplicate ids and makes stale cleanup harmless', () => {
+    const registry = new QuestionPresentationRegistry()
+    const old = registry.registerPresentation({ id: 'first', mode: 'individual' })
+    const second = registry.registerPresentation({ id: 'second', mode: 'aggregate' })
+    expect(registry.presentation.getSnapshot()).toEqual({ mode: 'individual' })
+    expect(() => registry.registerPresentation({ id: 'first', mode: 'aggregate' })).toThrow('duplicate presentation')
+    registry.dispose()
+    registry.registerPresentation({ id: 'first', mode: 'individual' })
+    old()
+    old()
+    second()
+    expect(registry.presentation.getSnapshot()).toEqual({ mode: 'individual' })
+    registry.dispose()
+    expect(registry.presentation.getSnapshot()).toEqual({ mode: 'aggregate' })
+  })
+})
