+/** Passive preview ownership over production Session, RemoteStream and journal readers. */
+import { Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import { LlmAttemptId } from '@deepseek-ai/dsh-llm'
+import { describe, expect, it, onTestFinished, vi } from 'vitest'
+import { SessionPreviews } from '../src/client/preview/service.ts'
+import { ClientSessions } from '../src/client/sessions/service.ts'
+import type { SessionListState } from '../src/client/sessions/service.ts'
+import type { SessionEventsPage } from '../src/types.ts'
+import { ev, plainTurn, historyValue } from './event-script.client.ts'
+import { imageRef } from './remote/session.client.ts'
+import { previewRemote } from './preview.fixture.ts'
+
+const ID = SessionId('preview-cold')
+
+function bench() {
+  const fixture = previewRemote()
+  const ctx = new Context()
+  const list = createSnapshotStore<SessionListState>({ ids: [], byId: {}, phase: 'ready', projectionsBySession: {} })
+  const previews = new SessionPreviews(ctx, fixture.remote, list)
+  onTestFinished(() => ctx.fiber.dispose())
+  return { fixture, ctx, list, previews }
+}
+
+describe('passive Session preview leases', () => {
+  it('opens an uncatalogued Session passively without creating a scope, row, input, or write capability', async () => {
+    const b = bench()
+    b.fixture.setOpening(historyValue(plainTurn(SessionSeq(0), 0, 'preview question', 'native answer')))
+    const before = b.list.getSnapshot()
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    expect(binding).toBe(lease.binding)
+    expect(binding.session.getSnapshot().openState).toBe('open')
+    expect(binding.eventSource.getSnapshot().entries.some(entry => entry.event.type === 'assistant/message')).toBe(true)
+    expect(b.fixture.followRequests).toMatchObject([{ address: { kind: 'session', sessionId: ID }, activate: false, assistantStream: true }])
+    expect(b.list.getSnapshot()).toBe(before)
+    expect(b.ctx.get('sessions')).toBeUndefined()
+    expect(Object.isFrozen(lease)).toBe(true)
+    expect(Object.keys(binding)).toEqual(['sessionId', 'session', 'eventSource'])
+    for (const key of ['reader', 'ctx', 'start', 'cancel', 'prompt', 'command', 'fork', 'rename', 'updateQueue', 'beginSubmission']) {
+      expect(key in lease).toBe(false)
+      expect(key in binding.session).toBe(false)
+    }
+    expect(Object.keys(b.ctx.get('sessionPreviews')!)).toEqual(['open'])
+    expect('append' in binding.eventSource).toBe(false)
+    expect('close' in binding.eventSource).toBe(false)
+    expect(b.fixture.write).not.toHaveBeenCalled()
+    const closing = lease.release()
+    expect(lease.signal.aborted).toBe(true)
+    expect(() => lease.binding).toThrow('released')
+    expect(lease.release()).toBe(closing)
+    await closing
+    expect(b.fixture.closed).toBe(b.fixture.opened)
+  })
+
+  it('keeps a main binding and two same-id preview generations independent', async () => {
+    const b = bench()
+    const main = new ClientSessions(b.ctx, b.fixture.remote)
+    b.fixture.list.mockResolvedValue({ ok: true, value: { items: [{ sessionId: ID, updatedAt: 1, running: false, blank: false, agentAvailable: true }] } })
+    await main.refresh()
+    const primary = main.retain(ID, { source: 'controllerOperation' })
+    onTestFinished(() => { primary.release() })
+    await primary.ready
+    const current = main.binding(ID)
+    const count = main.retainInfo(ID).getSnapshot()
+    const first = b.previews.open(ID)
+    const second = b.previews.open(ID)
+    const [a, c] = await Promise.all([first.ready, second.ready])
+    expect(a).not.toBe(c)
+    expect(a.session).not.toBe(c.session)
+    expect(a.eventSource).not.toBe(c.eventSource)
+    expect(main.binding(ID)).toBe(current)
+    expect(main.retainInfo(ID).getSnapshot()).toBe(count)
+    expect(b.fixture.followRequests.map(request => request.activate)).toEqual([true, false, false])
+    await first.release()
+    expect(second.signal.aborted).toBe(false)
+    b.fixture.push(ev.turnStart(SessionSeq(0), 0))
+    await vi.waitFor(() => { expect(c.eventSource.getSnapshot().entries).toHaveLength(1) })
+    expect(a.eventSource.getSnapshot().entries).toHaveLength(0)
+    expect(main.binding(ID)).toBe(current)
+    await second.release()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('reuses native Turn-aligned paging and sequenced projections without exposing writers', async () => {
+    const b = bench()
+    b.fixture.setOpening(historyValue(plainTurn(SessionSeq(6), 1, 'second', 'answer'), true))
+    b.fixture.page.mockResolvedValue({ ok: true, value: historyValue(plainTurn(SessionSeq(0), 0, 'first', 'answer')) })
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    const title = binding.session.projections.faceOf('title')
+    expect('close' in title).toBe(false)
+    b.previews.handleControlFrame({ type: 'projection', sessionId: ID, seq: 20, changes: [{ key: 'title', val: 'Current title' }] })
+    expect(title.getSnapshot()).toBe('Current title')
+    await binding.session.loadThrough(SessionSeq(0))
+    expect(binding.eventSource.getSnapshot().entries[0]?.event.seq).toBe(0)
+    expect(b.fixture.page.mock.calls[0]?.[0]).toMatchObject({ beforeSeq: 6, throughSeq: 11, maxMessages: 500, turnWindow: { minMessages: 200, minTurns: 2 } })
+    b.previews.handleConnected()
+    expect(title.getSnapshot()).toBeUndefined()
+    await lease.release()
+    b.previews.handleControlFrame({ type: 'projection', sessionId: ID, seq: 21, changes: [{ key: 'title', val: 'Too late' }] })
+    expect(title.getSnapshot()).toBeUndefined()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('withdraws borrowed sources synchronously and waits for an already-running image read', async () => {
+    const b = bench()
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    const entered = Promise.withResolvers<void>()
+    const response = Promise.withResolvers<Awaited<ReturnType<typeof b.fixture.attachment>>>()
+    onTestFinished(() => { response.resolve({ ok: true, value: { attachment: imageRef('fixture'), data: 'AA==' } }) })
+    b.fixture.attachment.mockImplementation(() => { entered.resolve(); return response.promise })
+    const pending = binding.session.readAttachment(imageRef('fixture'))
+    const rejected = expect(pending).rejects.toThrow('released')
+    await entered.promise
+    const notify = vi.fn()
+    const stop = binding.eventSource.subscribe(notify)
+    let settled = false
+    const closing = lease.release().then(() => { settled = true })
+    expect(settled).toBe(false)
+    const snapshot = binding.eventSource.getSnapshot()
+    b.previews.handleStatus(ID, true)
+    response.resolve({ ok: true, value: { attachment: imageRef('fixture'), data: 'AA==' } })
+    await rejected
+    await closing
+    expect(binding.eventSource.getSnapshot()).toBe(snapshot)
+    expect(notify).not.toHaveBeenCalled()
+    expect(binding.session.getSnapshot().running).toBe(false)
+    stop()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('joins a delayed older page and never publishes its late result after release', async () => {
+    const b = bench()
+    b.fixture.setOpening(historyValue(plainTurn(SessionSeq(6), 1, 'second', 'answer'), true))
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    const answer = Promise.withResolvers<Awaited<ReturnType<typeof b.fixture.page>>>()
+    const entered = Promise.withResolvers<void>()
+    b.fixture.page.mockImplementation(() => { entered.resolve(); return answer.promise })
+    onTestFinished(() => { answer.resolve({ ok: true, value: historyValue([]) }) })
+    const notify = vi.fn()
+    binding.eventSource.subscribe(notify)
+    const older = binding.session.loadOlder()
+    const rejected = expect(older).rejects.toThrow('released')
+    await entered.promise
+    let quiet = false
+    const closing = lease.release().then(() => { quiet = true })
+    const snapshot = binding.eventSource.getSnapshot()
+    expect(quiet).toBe(false)
+    answer.resolve({ ok: true, value: historyValue(plainTurn(SessionSeq(0), 0, 'first', 'answer')) })
+    await rejected
+    await closing
+    expect(binding.eventSource.getSnapshot()).toBe(snapshot)
+    expect(notify).not.toHaveBeenCalled()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('owns image bytes independently without revoking another view browser URLs', async () => {
+    const b = bench()
+    const revoke = vi.spyOn(URL, 'revokeObjectURL')
+    const first = b.previews.open(ID)
+    const second = b.previews.open(ID)
+    const [a, c] = await Promise.all([first.ready, second.ready])
+    expect((await a.session.readAttachment(imageRef('image'))).ok).toBe(true)
+    await first.release()
+    expect(second.signal.aborted).toBe(false)
+    expect((await c.session.readAttachment(imageRef('image'))).ok).toBe(true)
+    expect(revoke).not.toHaveBeenCalled()
+    await second.release()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('cancels only its opening and service unload joins every surviving lease', async () => {
+    const b = bench()
+    const abort = new AbortController()
+    abort.abort(new Error('cancelled before preview'))
+    expect(() => b.previews.open(ID, { signal: abort.signal })).toThrow('cancelled before preview')
+    expect(b.fixture.followRequests).toHaveLength(0)
+    const gate = Promise.withResolvers<SessionEventsPage>()
+    onTestFinished(() => { gate.resolve(historyValue([])) })
+    b.fixture.setOpening(gate.promise)
+    const lifetime = new AbortController()
+    const lease = b.previews.open(ID, { signal: lifetime.signal })
+    const rejected = expect(lease.ready).rejects.toThrow('preview superseded')
+    lifetime.abort(new Error('preview superseded'))
+    gate.resolve(historyValue([]))
+    await rejected
+    await lease.closed
+    b.fixture.setOpening(historyValue([]))
+    const survivor = b.previews.open(ID)
+    await survivor.ready
+    await b.ctx.fiber.dispose()
+    await survivor.closed
+    expect(survivor.signal.aborted).toBe(true)
+    expect(() => b.previews.open(ID)).toThrow('disposed')
+    expect(b.ctx.get('sessionPreviews')).toBeUndefined()
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('reconnects passively and folds live Assistant frames through native settlement', async () => {
+    const b = bench()
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    b.fixture.disconnect()
+    await vi.waitFor(() => { expect(b.fixture.followRequests).toHaveLength(2) })
+    expect(b.fixture.followRequests.every(request => request.activate === false)).toBe(true)
+    const attemptId = LlmAttemptId('preview-attempt')
+    b.fixture.pushFrame({ type: 'assistant-stream', frame: { type: 'start', attemptId, revision: 1, startedAfterSeq: -1, turn: 0, step: 0 } })
+    b.fixture.pushFrame({ type: 'assistant-stream', frame: { type: 'chunk', attemptId, revision: 2, index: 0, time: 1, chunk: { type: 'block-start', index: 0, blockType: 'text' } } })
+    await vi.waitFor(() => { expect(binding.eventSource.getSnapshot().entries.some(entry => entry.type === 'transient')).toBe(true) })
+    b.fixture.pushFrame({ type: 'assistant-stream', frame: { type: 'end', attemptId, revision: 3, index: 1, outcome: { kind: 'abandoned' } } })
+    await vi.waitFor(() => { expect(binding.eventSource.getSnapshot().entries).toHaveLength(0) })
+    await lease.release()
+    expect(b.fixture.closed).toBe(b.fixture.opened)
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('registers a synchronously reentrant attachment read before its lifetime can close', async () => {
+    const b = bench()
+    const lifetime = new AbortController()
+    const lease = b.previews.open(ID, { signal: lifetime.signal })
+    const binding = await lease.ready
+    const response = Promise.withResolvers<Awaited<ReturnType<typeof b.fixture.attachment>>>()
+    const entered = Promise.withResolvers<void>()
+    onTestFinished(() => { response.resolve({ ok: true, value: { attachment: imageRef('image'), data: 'AA==' } }) })
+    b.fixture.attachment.mockImplementation(() => {
+      lifetime.abort(new Error('reentrant cancellation'))
+      entered.resolve()
+      return response.promise
+    })
+    const pending = binding.session.readAttachment(imageRef('image'))
+    const rejected = expect(pending).rejects.toThrow('reentrant cancellation')
+    await entered.promise
+    let closed = false
+    void lease.closed.then(() => { closed = true })
+    expect(closed).toBe(false)
+    response.resolve({ ok: true, value: { attachment: imageRef('image'), data: 'AA==' } })
+    await rejected
+    await lease.closed
+    expect(b.fixture.closed).toBe(b.fixture.opened)
+    expect(b.fixture.write).not.toHaveBeenCalled()
+  })
+
+  it('keeps missing reads visible without promoting or retrying through writes', async () => {
+    const b = bench()
+    b.fixture.failOpening(new RemoteError('session/not-found', 'Missing preview', {}))
+    const lease = b.previews.open(ID)
+    const binding = await lease.ready
+    expect(binding.session.getSnapshot()).toMatchObject({ openState: 'error', openError: { code: 'session/not-found' } })
+    expect(b.fixture.followRequests).toHaveLength(1)
+    expect(b.fixture.write).not.toHaveBeenCalled()
+    await lease.release()
+  })
+})
