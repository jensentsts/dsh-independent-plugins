@@ -0,0 +1,37 @@
+/** Native question presentation election, independent of answer and request lifetimes. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { QuestionPresentation, QuestionPresentationRegistration, UiQuestionPresentation } from '@deepseek-ai/dsh-client-ui-tool/client'
+
+/** Internal provider; the public browser entry exposes only presentation declarations. */
+export class QuestionPresentationRegistry implements UiQuestionPresentation {
+  readonly contractVersion = 1
+  readonly presentation = createSnapshotStore<QuestionPresentation>({ mode: 'aggregate' })
+  private readonly entries = new Map<string, QuestionPresentationRegistration>()
+
+  registerPresentation(registration: QuestionPresentationRegistration): () => void {
+    if (this.entries.has(registration.id)) throw new Error(`ui-user-questions: duplicate presentation '${registration.id}'`)
+    const entry = { ...registration }
+    this.entries.set(entry.id, entry)
+    this.publish()
+    let active = true
+    return () => {
+      if (!active) return
+      active = false
+      if (this.entries.get(entry.id) !== entry) return
+      this.entries.delete(entry.id)
+      this.publish()
+    }
+  }
+
+  /** Remove every preference when the native question plugin unloads. */
+  dispose(): void {
+    this.entries.clear()
+    this.publish()
+  }
+
+  private publish(): void {
+    const selected = [...this.entries.values()].sort((a, b) => (a.priority ?? 100) - (b.priority ?? 100))[0]
+    const mode = selected?.mode ?? 'aggregate'
+    if (this.presentation.getSnapshot().mode !== mode) this.presentation.set({ mode })
+  }
+}
diff --git a/packages/client/ui-user-questions/tests/question-presentation.client.spec.ts b/packages/client/ui-user-questions/tests/question-presentation.client.spec.ts
