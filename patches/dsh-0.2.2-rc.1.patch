+/** Passive preview extension over the already-mounted official Session controller. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { ConnectionHandle } from '@deepseek-ai/dsh-client-connection/client'
+import type {} from './index.ts'
+import { SessionPreviews } from './preview/service.ts'
+import type { SessionRemotes } from './sessions/remotes.ts'
+import { createSessionControlStream } from './transport.ts'
+
+/** Services supplied by the official Session controller and connection. */
+export const inject = ['sessions', 'connection', 'remote', 'remote.session', 'remote.subagents']
+
+/**
+ * Register independently owned history readers beside the interactive controller.
+ * @param ctx - preview extension lifetime.
+ */
+export function apply(ctx: Context): void {
+  const remotes = ctx.remote as SessionRemotes
+  const connection = ctx.get('connection') as ConnectionHandle
+  const previews = new SessionPreviews(ctx, remotes, ctx.sessions.list)
+  ctx.remote.$on('api-session/removed', sessionId => { previews.handleRemoved(sessionId) })
+  ctx.remote.$on('api-session/status', (sessionId, running) => { previews.handleStatus(sessionId, running) })
+  const control = createSessionControlStream(remotes, {
+    accept: frame => { previews.handleControlFrame(frame) },
+    failed: error => { console.error('[session-previews] control stream failed:', error) },
+  })
+  const connected = (): void => {
+    if (connection.generation.getSnapshot() === undefined) return
+    previews.handleConnected()
+    control.restart()
+    control.start()
+  }
+  ctx.effect(() => connection.generation.subscribe(connected), 'session-previews: connection generation')
+  ctx.effect(() => async () => { await control.dispose() }, 'session-previews: control stream')
+  connected()
+}
