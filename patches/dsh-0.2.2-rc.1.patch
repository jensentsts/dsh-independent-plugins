index 00000000..a54ddc35
--- /dev/null
+++ b/packages/client/ui-chat/src/client/contract/message-chrome.ts
@@ -0,0 +1,128 @@
+/** Native-message decoration data; contributions never receive the message body. */
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { FactoryComponentPropsOf, InjectFace, PropsRenderFactories, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+
+/** One stable native render occurrence, scoped to the surrounding Session. */
+export interface ChatMessageOwner {
+  readonly contractVersion: 1
+  /** Stable across streaming, settlement, and decoration changes. */
+  readonly instanceKey: string
+  readonly kind: string
+  /** Containers and controls are always transparent and never render identity chrome. */
+  readonly part?: 'message' | 'reasoning' | 'tool' | 'pending' | 'container' | 'control'
+  readonly groupPart?: string
+  readonly nodeKey?: string
+  readonly turn?: number
+  readonly step?: number
+  readonly messageId?: string
+  readonly callId?: string
+  readonly toolName?: string
+  readonly phase?: 'preparing' | 'start' | 'result'
+  /** Original source value when present; consumers must narrow producer-owned data. */
+  readonly source?: unknown
+  readonly pending?: boolean
+  readonly echo?: boolean
+  /** Original Assistant block position, not its position after filtering. */
+  readonly blockIndex?: number
+  /** Identity v1 carries no layout geometry. Native avatarPlacementVersion owns automatic placement. */
+  readonly gutter: { readonly available: false; readonly width: 0 }
+}
+
+/** Pure appearance selection, applied to the existing native wrapper. */
+export interface ChatMessageAppearance {
+  readonly variant: 'native' | 'bubble' | 'transparent'
+  readonly align?: 'start' | 'end'
+  /** Native request only: auto uses available outer margin; omission and header keep the avatar inline. */
+  readonly avatarPlacement?: 'header' | 'auto'
+  /** Contribution-owned classes; resolved appearances also contain the official frame classes. */
+  readonly className?: string
+  /** CSS custom properties only; layout, positioning, overflow, and stacking stay native-owned. */
+  readonly variables?: Readonly<Record<`--${string}`, string | number>>
+}
+
+/** One appearance contributor; null delegates to the next contributor. */
+export interface ChatMessageAppearanceRegistration {
+  readonly id: string
+  /** Lower ranks select first; omission uses 100, and ties retain registration order. */
+  readonly priority?: number
+  /** @param owner - native occurrence identity. @returns appearance or delegation. */
+  readonly select: (owner: ChatMessageOwner) => ChatMessageAppearance | null
+}
+
+/** Snapshot callback whose identity changes only when appearance registrations change. */
+export type ChatMessageAppearanceResolver = (owner: ChatMessageOwner) => ChatMessageAppearance
+
+/** Identity-stable render snapshot, replaced only when registrations change. */
+export interface ChatMessageAppearanceSnapshot {
+  readonly resolve: ChatMessageAppearanceResolver
+}
+
+/** Public native-message appearance registry, owned by ui-chat's plugin lifetime. */
+export interface UiChatChrome {
+  readonly contractVersion: 1
+  /** Native CSS placement from the actual view's margins; no body width is reserved or reduced. */
+  readonly avatarPlacementVersion: 1
+  /** Bare source for apply-world injection; components receive only its framework-bound hook. */
+  readonly appearances: ObservableSnapshot<ChatMessageAppearanceSnapshot>
+  /**
+   * Register a pure appearance selector. Duplicate ids throw; controls and containers ignore selectors.
+   * Selector exceptions are reported and delegate, so a failed decoration never hides native content.
+   * @param registration - identity, rank, and pure owner-data selector.
+   * @returns idempotent disposer; register through the contributing Context's effect lifetime.
+   */
+  registerAppearance(registration: ChatMessageAppearanceRegistration): () => void
+}
+
+/** Apply-world source, bound by the renderer rather than by presentation code. */
+export interface ChatMessageAppearanceInjected {
+  readonly hooks: { readonly chatChrome: ObservableSnapshot<ChatMessageAppearanceSnapshot> }
+}
+
+/** Plain data and framework renderer forwarded to an existing native message wrapper. */
+export interface ChatMessageFrameInput extends PropsRenderFactories {
+  readonly owner: ChatMessageOwner
+  readonly resolveAppearance: ChatMessageAppearanceResolver
+}
+
+/** Framework-created appearance hook share. */
+export type ChatMessageAppearanceProps = InjectFace<ChatMessageAppearanceInjected>
+
+/** Owner share for both optional identity positions. */
+export interface ChatMessageChromeOwnerProps {
+  readonly owner: ChatMessageOwner
+}
+
+/** Complete props for an independently registered identity header or avatar. */
+export type ChatMessageChromeProps = PropsRuntime<'conversation.chat.message.header' | 'conversation.chat.message.avatar'>
+
+/** Complete props for the native chrome Factory, which never owns the message body. */
+export type ChatMessageChromeFactoryProps = FactoryComponentPropsOf<'conversation.chat.message.chrome'>
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Native-message decoration capability; absence means the host does not support this version. */
+    uiChatChrome: UiChatChrome
+  }
+}
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface SlotFactoryMap {
+    /** Identity-only chrome; native bodies remain outside the Factory at their original outlet. */
+    'conversation.chat.message.chrome': {
+      scope: 'session'
+      props: ChatMessageChromeOwnerProps
+      locale: 'chat'
+      inject: ChatMessageAppearanceInjected
+      children: {
+        'conversation.chat.message.header': { kind: 'single'; scope: 'session' }
+        'conversation.chat.message.avatar': { kind: 'single'; scope: 'session' }
+      }
+    }
+  }
+  interface SlotMap {
+    /** Optional identity header; no children, renderer delegation, or message-body access. */
+    'conversation.chat.message.header': { kind: 'single'; scope: 'session'; owner: ChatMessageChromeOwnerProps }
+    /** Optional avatar; native layout owns inline or outer-margin placement without changing the body. */
+    'conversation.chat.message.avatar': { kind: 'single'; scope: 'session'; owner: ChatMessageChromeOwnerProps }
+  }
+}
