+    removeTie()
+    expect(resolve(registry)).toEqual({ variant: 'native' })
+    removeDecline()
+    stop()
+  })
+
+  it('rejects duplicate ids and makes old cleanup unable to clear a replacement', () => {
+    const registry = new ChatChromeRegistry()
