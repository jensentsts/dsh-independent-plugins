+/** Owner-side passive preview lifetimes and private historical image URLs. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import type { ISessionPreviews, SessionPreviewBinding, SessionPreviewLease } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { UiSessionPreview } from '@deepseek-ai/dsh-client-ui-session/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { bytesToBase64 } from '@deepseek-ai/dsh-util-crypto'
+import type { ConversationPreviewInjected } from './contract.ts'
+
+/** One owner-created read lease per mounted preview, including when two use the same Session id. */
+export class ConversationPreviews implements ConversationPreviewInjected {
+  private sequence = 0
+  private readonly leases = new Map<number, SessionPreviewLease>()
+
+  /** @param ctx - Conversation plugin context. @param readers - passive read provider. @param uiSessionPreview - passive read-scope adapter. */
+  constructor(ctx: Context, private readonly readers: ISessionPreviews, private readonly uiSessionPreview: UiSessionPreview) {
+    ctx.effect(() => async () => {
+      const results = await Promise.allSettled([...this.leases.values()].map(lease => lease.release()))
+      this.leases.clear()
+      const rejected = results.find(result => result.status === 'rejected')
+      if (rejected?.status === 'rejected') throw rejected.reason
+    }, 'ui-conversation: native passive previews')
+  }
+
+  /** @inheritdoc */
+  openPreview(sessionId: SessionId) {
+    const lease = this.readers.open(sessionId)
+    const id = ++this.sequence
+    this.leases.set(id, lease)
+    return { id, target: this.uiSessionPreview.attach(lease) }
+  }
+
+  /** @inheritdoc */
+  async closePreview(id: number): Promise<void> {
+    const lease = this.leases.get(id)
+    if (lease === undefined) return
+    this.leases.delete(id)
+    await lease.release()
+  }
+}
+
+/** Image URLs belong to this reader alone and are never adopted from another view. */
+export class PreviewImages {
+  private readonly entries = new Map<string, { current?: string; readonly pending: Promise<string> }>()
+
+  /** @param binding - passive reader. @param signal - preview lifetime. */
+  constructor(private readonly binding: SessionPreviewBinding, private readonly signal: AbortSignal) {
+    signal.addEventListener('abort', () => {
+      for (const entry of this.entries.values()) if (entry.current?.startsWith('blob:')) URL.revokeObjectURL(entry.current)
+      this.entries.clear()
+    }, { once: true })
+  }
+
+  /** @param attachment - durable image reference. @returns independently owned preview URL. */
+  resolve(attachment: ImageAttachmentRef): Promise<string> {
+    this.signal.throwIfAborted()
+    const key = attachment.attachmentId
+    const existing = this.entries.get(key)
+    if (existing !== undefined) return existing.pending
+    const entry: { current?: string; readonly pending: Promise<string> } = {
+      pending: this.binding.session.readAttachment(attachment).then(result => {
+        this.signal.throwIfAborted()
+        if (!result.ok) throw new Error(`${result.error.code}: ${result.error.message}`)
+        const bytes = Uint8Array.from(result.value.data)
+        const url = typeof URL.createObjectURL === 'function'
+          ? URL.createObjectURL(new Blob([bytes.buffer], { type: result.value.attachment.mediaType }))
+          : `data:${result.value.attachment.mediaType};base64,${bytesToBase64(bytes)}`
+        entry.current = url
+        return url
+      }),
+    }
+    this.entries.set(key, entry)
+    return entry.pending
+  }
+
+  /** @param attachment - durable image reference. @returns resolved URL without initiating a read. */
+  peek(attachment: ImageAttachmentRef): string | undefined { return this.entries.get(attachment.attachmentId)?.current }
+}
diff --git a/packages/client/ui-session/src/client/preview-binding.ts b/packages/client/ui-session/src/client/preview-binding.ts
new file mode 100644
index 00000000..9067acd3
--- /dev/null
+++ b/packages/client/ui-session/src/client/preview-binding.ts
@@ -0,0 +1,153 @@
+/** Independently owned Session read bindings; these never enter the canonical Session roster. */
+import { Service, type Context } from '@deepseek-ai/cordis'
+import type { SessionPreviewBinding, SessionPreviewLease } from '@deepseek-ai/dsh-api-session-controller/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { standardHookPropName } from '@deepseek-ai/dsh-client-ui-slots'
+import type {
+  HostObservable, KeyedStandardSource, ScopedStandardSourceBinding, StandardSourceBinding,
+} from '@deepseek-ai/dsh-client-ui-slots'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Opaque target accepted only while its owning preview lease is live. */
+export interface SessionPreviewTarget {
+  readonly kind: 'preview'
+  readonly sessionId: SessionId
+}
+
+/** Read sources available to an explicitly preview-safe domain contribution. */
+export interface SessionPreviewSources {
+  readonly hooks?: Readonly<Record<string, HostObservable<unknown>>>
+  readonly keyedHooks?: Readonly<Record<string, KeyedStandardSource>>
+  readonly props?: Readonly<Record<string, unknown>>
+}
+
+/** An opt-in domain adapter receives only a passive reader and its owning lifetime. */
+export interface SessionPreviewSourceDescriptor {
+  /** @param binding - independent read face. @param signal - preview lifetime. @returns preview-safe sources. */
+  resolve(binding: SessionPreviewBinding, signal: AbortSignal): SessionPreviewSources
+}
+
+interface PreviewRecord {
+  readonly lease: SessionPreviewLease
+  readonly source: ReturnType<typeof createSnapshotStore<StandardSourceBinding>>
+  readonly ctx: Context
+  readonly contributions: Map<SessionPreviewSourceDescriptor, SessionPreviewSources>
+  readonly stop: () => void
+}
+
+/** Scope adapter state owned by ui-session, separate from main references and status tracking. */
+export class PreviewBindings extends Service {
+  private readonly records = new Map<SessionPreviewTarget, PreviewRecord>()
+  private readonly descriptors = new Set<SessionPreviewSourceDescriptor>()
+  private readonly contexts = new WeakMap<Context, PreviewRecord>()
+  private sequence = 0
+
+  /** @param ctx - ui-session plugin lifetime. @param absent - explicit no-Session source. */
+  constructor(ctx: Context, private readonly absent: HostObservable<StandardSourceBinding>) {
+    super(ctx, 'uiSessionPreview')
+    ctx.effect(() => async () => {
+      await Promise.allSettled([...this.records.values()].map(record => record.lease.release()))
+      for (const record of [...this.records.values()]) record.stop()
+    }, 'ui-session: passive view bindings')
+  }
+
+  /** @param descriptor - preview-safe domain adapter. @returns caller-owned disposer. */
+  provide(descriptor: SessionPreviewSourceDescriptor): () => void {
+    const dispose = this.ctx.effect(() => {
+      this.descriptors.add(descriptor)
+      for (const record of this.records.values()) this.materialize(record)
+      return () => {
+        this.descriptors.delete(descriptor)
+        for (const record of this.records.values()) {
+          record.contributions.delete(descriptor)
+          this.materialize(record)
+        }
+      }
+    }, 'ui-session: preview source contribution')
+    return () => { void dispose() }
+  }
+
+  /** @param lease - externally owned passive lifetime. @returns opaque target for SessionProvider. */
+  attach(lease: SessionPreviewLease): SessionPreviewTarget {
+    lease.signal.throwIfAborted()
+    const target: SessionPreviewTarget = Object.freeze({ kind: 'preview', sessionId: lease.sessionId })
+    const fiber = this.ctx.plugin(function previewView() {})
+    const source = createSnapshotStore<StandardSourceBinding>(this.absent.getSnapshot())
+    const contributions = new Map<SessionPreviewSourceDescriptor, SessionPreviewSources>()
+    const stop = (): void => {
+      if (!this.records.delete(target)) return
+      lease.signal.removeEventListener('abort', stop)
+      source.set(this.absent.getSnapshot())
+      this.contexts.delete(fiber.ctx)
+      void fiber.dispose()
+    }
+    const record: PreviewRecord = { lease, source, ctx: fiber.ctx, contributions, stop }
+    this.records.set(target, record)
+    this.contexts.set(record.ctx, record)
+    // Context identity is independent even when two readers address the same durable Session.
+    this.materialize(record, `preview:${Date.now().toString(36)}:${++this.sequence}`)
+    lease.signal.addEventListener('abort', stop, { once: true })
+    return target
+  }
+
+  /** @param target - attached target. @returns exact binding source, or explicit absence after release. */
+  source(target: SessionPreviewTarget): HostObservable<StandardSourceBinding> {
+    return this.records.get(target)?.source ?? this.absent
+  }
+
+  /** @param scope - renderer binding; absent with an earlier renderer. @returns its passive reader, or absence for an ordinary view. */
+  reader(scope: ScopedStandardSourceBinding | undefined): SessionPreviewBinding | undefined {
+    if (scope === undefined) return undefined
+    const record = this.contexts.get(scope.ctx)
+    return record === undefined || record.lease.signal.aborted ? undefined : record.lease.binding
+  }
+
+  /** @param scope - renderer binding; absent with an earlier renderer. @returns its passive lifetime, or absence for an ordinary view. */
+  signal(scope: ScopedStandardSourceBinding | undefined): AbortSignal | undefined {
+    return scope === undefined ? undefined : this.contexts.get(scope.ctx)?.lease.signal
+  }
+
+  private materialize(record: PreviewRecord, viewKey?: string): void {
+    const binding = record.lease.binding
+    const hooks: Record<string, HostObservable<unknown>> = { session: binding.session }
+    const keyedHooks: Record<string, KeyedStandardSource> = {
+      projection: key => binding.session.projections.faceOf(key),
+    }
+    const props: Record<string, unknown> = { sessionId: binding.sessionId, readOnly: true }
+    const final = new Set(['useSession', 'useProjection', 'sessionId', 'readOnly'])
+    for (const descriptor of this.descriptors) {
+      let contribution = record.contributions.get(descriptor)
+      if (contribution === undefined) {
+        contribution = descriptor.resolve(binding, record.lease.signal)
+        record.contributions.set(descriptor, contribution)
+      }
+      const copy = <T>(values: Readonly<Record<string, T>> | undefined, destination: Record<string, T>, hook: boolean): void => {
+        for (const [name, value] of Object.entries(values ?? {})) {
+          const prop = hook ? standardHookPropName(name) : name
+          if (final.has(prop)) throw new Error(`ui-session: duplicate preview source '${prop}'`)
+          final.add(prop)
+          destination[name] = value
+        }
+      }
+      copy(contribution.hooks, hooks, true)
+      copy(contribution.keyedHooks, keyedHooks, true)
+      copy(contribution.props, props, false)
+    }
+    const previous = record.source.getSnapshot()
+    const value: ScopedStandardSourceBinding = {
+      key: binding.sessionId, ctx: record.ctx, hooks, keyedHooks, props,
+      viewKey: viewKey ?? ('viewKey' in previous ? previous.viewKey : undefined),
+    }
+    record.source.set(value)
+  }
+}
+
+/** Optional passive-view operations supplied by the matching Session UI adapter. */
+export type UiSessionPreview = Pick<PreviewBindings, 'provide' | 'attach' | 'reader' | 'signal'>
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Passive-view capability; ordinary conversation startup does not require it. */
+    uiSessionPreview: UiSessionPreview
+  }
+}
