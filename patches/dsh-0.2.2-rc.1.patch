+/** Independent passive history readers, excluded from canonical Session and Agent scopes. */
+import type { Context } from '@deepseek-ai/cordis'
+import type { ImageAttachmentRef } from '@deepseek-ai/dsh-attachment'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import { SessionSeq, type SessionId, type SessionSeqCursor } from '@deepseek-ai/dsh-session/types'
+import type { SessionControlFrame } from '../../types.ts'
+import type {
+  ISessionPreviews, SessionPreviewBinding, SessionPreviewFace, SessionPreviewLease,
+} from '../contract/preview.ts'
+import type { SessionListState } from '../sessions/service.ts'
+import type { SessionRemotes } from '../sessions/remotes.ts'
+import { Session } from '../sessions/session.ts'
+
+/** A borrowed observable stops delegating before its owner's asynchronous teardown starts. */
+class PreviewSource<T> implements ObservableSnapshot<T> {
+  private snapshot: T
+  private readonly stops = new Set<() => void>()
+  private closed = false
+
+  constructor(private readonly source: ObservableSnapshot<T>) {
+    this.snapshot = source.getSnapshot()
+  }
+
+  getSnapshot(): T {
+    if (!this.closed) this.snapshot = this.source.getSnapshot()
+    return this.snapshot
+  }
+
+  subscribe(listener: () => void): () => void {
+    if (this.closed) return () => {}
+    const stop = this.source.subscribe(() => { if (!this.closed) listener() })
+    this.stops.add(stop)
+    return () => { this.stops.delete(stop); stop() }
+  }
+
+  close(): void {
+    if (this.closed) return
+    this.snapshot = this.source.getSnapshot()
+    this.closed = true
+    for (const stop of this.stops) stop()
+    this.stops.clear()
+  }
+}
+
+class PreviewLease {
+  private readonly lifetime = new AbortController()
+  private readonly opening = Promise.withResolvers<SessionPreviewBinding>()
+  private readonly ending = Promise.withResolvers<void>()
+  private readonly pending = new Set<Promise<unknown>>()
+  private readonly sources = new Set<{ close(): void }>()
+  private readonly projectionSources = new Map<string, ObservableSnapshot<unknown>>()
+  private readonly value: SessionPreviewBinding
+  readonly face: SessionPreviewLease
+  private closing: Promise<void> | undefined
+  private unlink = (): void => {}
+  readonly ready = this.opening.promise
+  readonly closed = this.ending.promise
+  readonly signal = this.lifetime.signal
+
+  constructor(
+    readonly sessionId: SessionId,
+    readonly reader: Session,
+    remote: SessionRemotes,
+    private readonly ended: () => void,
+  ) {
+    const snapshot = this.source(reader)
+    const events = this.source(reader.eventSource)
+    const face: SessionPreviewFace = Object.freeze({
+      sessionId,
+      getSnapshot: () => snapshot.getSnapshot(),
+      subscribe: (listener: () => void) => snapshot.subscribe(listener),
+      projections: Object.freeze({ faceOf: (key: string) => this.projectionSource(key) }),
+      loadOlder: () => this.run(() => reader.loadOlder()),
+      loadThrough: (seq: SessionSeq) => this.run(() => reader.loadThrough(seq)),
+      readAttachment: (attachment: ImageAttachmentRef) => this.run(async () => {
+        const result = await remote.session.attachment({ sessionId, attachment }, this.signal)
+        this.signal.throwIfAborted()
+        if (!result.ok) return result
+        const binary = atob(result.value.data)
+        return { ok: true as const, value: {
+          attachment: result.value.attachment,
+          data: Uint8Array.from(binary, char => char.charCodeAt(0)),
+        } }
+      }),
+    })
+    this.value = Object.freeze({ sessionId, session: face, eventSource: events })
+    const owner = this
+    this.face = Object.freeze({
+      sessionId, signal: this.signal, ready: this.ready, closed: this.closed,
+      get binding() { return owner.binding },
+      release: () => this.release(),
+      [Symbol.asyncDispose]: () => this.release(),
+    })
+    // A caller may release before attaching its readiness waiter; the public Promise remains rejecting.
+    void this.ready.catch((_error: unknown) => {})
+    void this.closed.catch((_error: unknown) => {})
+  }
+
+  start(signal: AbortSignal | undefined): void {
+    if (signal !== undefined) {
+      const abort = (): void => { void this.release(signal.reason) }
+      signal.addEventListener('abort', abort, { once: true })
+      this.unlink = () => { signal.removeEventListener('abort', abort) }
+      if (signal.aborted) { abort(); return }
+    }
+    void this.run(() => this.reader.open()).then(
+      () => { if (!this.signal.aborted) this.opening.resolve(this.value) },
+      (error: unknown) => { this.opening.reject(error) },
+    )
+  }
+
+  get binding(): SessionPreviewBinding {
+    this.signal.throwIfAborted()
+    return this.value
+  }
+
+  release(reason: unknown = new Error('Session preview is released')): Promise<void> {
+    if (this.closing !== undefined) return this.closing
+    this.closing = this.closed
+    this.lifetime.abort(reason)
+    this.unlink()
+    this.opening.reject(reason)
+    for (const source of this.sources) source.close()
+    const stopping = this.reader.dispose()
+    void (async () => {
+      try {
+        const [stopped] = await Promise.allSettled([stopping, Promise.allSettled([...this.pending])])
+        if (stopped.status === 'rejected') throw stopped.reason
+        this.ending.resolve()
+      } catch (error: unknown) {
+        this.ending.reject(error)
+      } finally {
+        this.ended()
+      }
+    })()
+    return this.closed
+  }
+
+  [Symbol.asyncDispose](): Promise<void> { return this.release() }
+
+  private source<T>(source: ObservableSnapshot<T>): ObservableSnapshot<T> {
+    const borrowed = new PreviewSource(source)
+    this.sources.add(borrowed)
+    return Object.freeze({ getSnapshot: () => borrowed.getSnapshot(), subscribe: (listener: () => void) => borrowed.subscribe(listener) })
+  }
+
+  private projectionSource(key: string): ObservableSnapshot<unknown> {
+    let source = this.projectionSources.get(key)
+    if (source === undefined) {
+      this.signal.throwIfAborted()
+      source = this.source(this.reader.projections.faceOf(key))
+      this.projectionSources.set(key, source)
+    }
+    return source
+  }
+
+  private run<T>(operation: () => Promise<T>): Promise<T> {
+    this.signal.throwIfAborted()
+    // Register ownership before invoking an external read, including a synchronously reentrant one.
+    const pending = Promise.resolve().then(async () => {
+      this.signal.throwIfAborted()
+      const result = await operation()
+      this.signal.throwIfAborted()
+      return result
+    })
+    this.pending.add(pending)
+    void pending.then(
+      () => { this.pending.delete(pending) },
+      (_error: unknown) => { this.pending.delete(pending) },
+    )
+    return pending
+  }
+}
+
+/** Controller-owned passive readers, each with private history and projection stores. */
+export class SessionPreviews implements ISessionPreviews {
+  private readonly leases = new Set<PreviewLease>()
+  private disposed = false
+
+  /**
+   * @param ctx - Controller plugin context owning every remaining lease.
+   * @param remote - generated Remote operations and Gateway stream factory.
+   * @param list - read-only catalog hints; preview acquisition never changes this source.
+   */
+  constructor(
+    ctx: Context,
+    private readonly remote: SessionRemotes,
+    private readonly list: ObservableSnapshot<SessionListState>,
+  ) {
+    ctx.reflect.provide('sessionPreviews', Object.freeze({
+      open: (sessionId: SessionId, options?: { readonly signal?: AbortSignal }) => this.open(sessionId, options),
+    }), undefined)
+    ctx.effect(() => async () => {
+      this.disposed = true
+      const results = await Promise.allSettled([...this.leases].map(lease => lease.release()))
+      const failure = results.find(result => result.status === 'rejected')
+      if (failure?.status === 'rejected') throw failure.reason
+    }, 'session-controller: passive previews')
+  }
+
+  /** @inheritdoc */
+  open(sessionId: SessionId, options: { readonly signal?: AbortSignal } = {}): SessionPreviewLease {
+    options.signal?.throwIfAborted()
+    if (this.disposed) throw new Error('Session previews are disposed')
+    const reader = new Session(sessionId, this.remote, {}, false)
+    const row = this.list.getSnapshot().byId[sessionId]
+    if (row !== undefined) { reader.handleRunning(row.running); reader.handleBlank(row.blank) }
+    const lease = new PreviewLease(sessionId, reader, this.remote, () => { this.leases.delete(lease) })
+    this.leases.add(lease)
+    lease.start(options.signal)
+    return lease.face
+  }
+
+  /**
+   * Clear previous Host-generation watermarks before its replacement baselines arrive.
+   * @internal
+   */
+  handleConnected(): void {
+    for (const lease of this.leases) if (!lease.signal.aborted) lease.reader.projections.clear()
+  }
+
+  /**
+   * Apply authorized control frames only to independently open readers.
+   * @param frame - Host baseline or sequenced projection update.
+   * @internal
+   */
+  handleControlFrame(frame: SessionControlFrame): void {
+    for (const lease of this.leases) {
+      if (lease.signal.aborted) continue
+      if (frame.type === 'baseline') {
+        const block = frame.value.projections[lease.sessionId]
+        if (block === undefined) continue
+        const asOfSeq: SessionSeqCursor = block.asOfSeq === -1 ? -1 : SessionSeq(block.asOfSeq)
+        lease.reader.projections.seed({ ...block, asOfSeq })
+      } else if (frame.sessionId === lease.sessionId) {
+        for (const change of frame.changes) lease.reader.projections.apply(change.key, change.val, SessionSeq(frame.seq))
+      }
+    }
+  }
+
+  /** @param sessionId - changed Session. @param running - authoritative Agent running bit. @internal */
+  handleStatus(sessionId: SessionId, running: boolean): void {
+    for (const lease of this.leases) if (!lease.signal.aborted && lease.sessionId === sessionId) lease.reader.handleRunning(running)
+  }
+
+  /** @param sessionId - removed Session. @internal */
+  handleRemoved(sessionId: SessionId): void {
+    for (const lease of this.leases) if (!lease.signal.aborted && lease.sessionId === sessionId) lease.reader.handleRemoved()
+  }
+}
