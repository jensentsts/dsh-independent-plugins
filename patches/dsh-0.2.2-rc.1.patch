diff --git a/packages/client/ui-chat/src/client/chat/file-attachment.ts b/packages/client/ui-chat/src/client/chat/file-attachment.ts
new file mode 100644
index 00000000..84efc702
--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/file-attachment.ts
@@ -0,0 +1,20 @@
+import type { AttachmentId, FileAttachmentRef } from '@deepseek-ai/dsh-attachment'
+
+/**
+ * Narrow one Assistant `other` content block to a durable file reference.
+ * A file block reaches this renderer through the merge-extensible content union,
+ * not through a Chat-specific projection member, so the durable fields are read
+ * and checked here instead of trusting an unvalidated block.
+ * @param block - raw content block retained by the Assistant projection.
+ * @returns the durable file reference, or null for every other block.
+ */
+export function assistantFileReference(block: unknown): FileAttachmentRef | null {
+  if (typeof block !== 'object' || block === null || Array.isArray(block)) return null
+  const { type, attachment } = block as { type?: unknown; attachment?: unknown }
+  if (type !== 'file' || typeof attachment !== 'object' || attachment === null || Array.isArray(attachment)) return null
+  const { attachmentId, name, bytes } = attachment as Record<string, unknown>
+  if (typeof attachmentId !== 'string' || attachmentId === '') return null
+  if (typeof name !== 'string' || name === '') return null
+  if (typeof bytes !== 'number' || !Number.isInteger(bytes) || bytes < 0) return null
+  return { attachmentId: attachmentId as AttachmentId, name, bytes }
+}
diff --git a/packages/client/ui-chat/src/client/chat/message-gutter.ts b/packages/client/ui-chat/src/client/chat/message-gutter.ts
new file mode 100644
index 00000000..bd9ac47e
--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat/message-gutter.ts
@@ -0,0 +1,60 @@
+/** Native avatar clearance measured once for each rendered Chat viewport. */
+
+/** Space for a 28px avatar, 8px body separation, and 4px edge clearance. */
+const AVATAR_GUTTER_WIDTH = 40
+
+interface HorizontalBounds {
+  readonly left: number
+  readonly right: number
+}
+
+/** Native CSS facts; they belong to the scroll container, not appearance variables. */
+interface MessageGutter {
+  readonly left: boolean
+  readonly right: boolean
+}
+
+/**
+ * Resolve both physical sides against the current viewport's clipping intersection.
+ * @param column - the unchanged transcript body column.
+ * @param clips - native scrollport and enclosing horizontal clip bounds.
+ * @returns the sides that can hold the complete avatar clearance.
+ */
+export function resolveMessageGutter(column: HorizontalBounds, clips: readonly HorizontalBounds[]): MessageGutter {
+  const left = Math.max(...clips.map(clip => clip.left))
+  const right = Math.min(...clips.map(clip => clip.right))
+  return {
+    left: column.right <= right && column.left - left >= AVATAR_GUTTER_WIDTH,
+    right: column.left >= left && right - column.right >= AVATAR_GUTTER_WIDTH,
+  }
+}
+
+/**
+ * Publish native-owned CSS placement facts without observing individual messages.
+ * @param list - the named Chat style-query container.
+ * @param column - the existing transcript body column.
+ */
+export function publishMessageGutter(list: HTMLElement, column: HTMLElement): void {
+  const clips: HorizontalBounds[] = []
+  for (let element: HTMLElement | null = list; element !== null; element = element.parentElement) {
+    const style = getComputedStyle(element)
+    if (element === list || /^(?:auto|scroll|hidden|clip)$/u.test(style.overflowX)
+      || /(?:^|\s)(?:paint|strict|content)(?:\s|$)/u.test(style.contain)) {
+      const rect = element.getBoundingClientRect()
+      const left = rect.left + element.clientLeft
+      clips.push({ left, right: left + element.clientWidth })
+    }
+  }
+  const gutter = resolveMessageGutter(column.getBoundingClientRect(), clips)
+  list.style.setProperty('--dsh-native-message-gutter-left', gutter.left ? '1' : '0')
+  list.style.setProperty('--dsh-native-message-gutter-right', gutter.right ? '1' : '0')
+}
+
+/**
+ * Release the placement facts owned by a detached Chat viewport.
+ * @param list - the former Chat style-query container.
+ */
+export function clearMessageGutter(list: HTMLElement): void {
+  list.style.removeProperty('--dsh-native-message-gutter-left')
+  list.style.removeProperty('--dsh-native-message-gutter-right')
+}
