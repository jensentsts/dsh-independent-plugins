+    expect(() => registry.registerAppearance({ id: 'bubble', select: () => null })).toThrow('duplicate appearance')
+    registry.dispose()
+    const removeNext = registry.registerAppearance({ id: 'bubble', select: () => ({ variant: 'bubble', align: 'end' }) })
