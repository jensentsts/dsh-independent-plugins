+/** Public alias registrar preserves native identity, mutation guards and calling-context ownership. */
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { mkdtemp, mkdir, rm, writeFile, symlink } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { LocalFileSystem } from '@deepseek-ai/dsh-fs-local'
+import type { FsPathAliasResolver } from '@deepseek-ai/dsh-fs'
+
+let ctx: Context
+let dir: string
+let root: string
+beforeEach(async () => {
+  dir = await mkdtemp(join(tmpdir(), 'dsh-fs-alias-'))
+  root = join(dir, 'root'); await mkdir(root)
+  ctx = new Context(); await ctx.plugin(LocalFileSystem, { cwd: dir })
+})
+afterEach(async () => { await ctx.fiber.dispose(); await rm(dir, { recursive: true, force: true }) })
+
+describe('path alias registration', () => {
+  const resolver: FsPathAliasResolver = (path, options) => path.startsWith('@test/') ? { path: join(options.cwd ?? '', 'root', path.slice(6)), root: join(options.cwd ?? '', 'root') } : undefined
+  it('creates absent aliases and preserves native identity and version guards', async () => {
+    ctx.fs.registerPathAlias(resolver)
+    const alias = await ctx.fs.resolve('@test/a.txt')
+    const created = await ctx.fs.writeText(alias, 'first', { kind: 'createIfAbsent' })
+    expect(alias.targetKey).toBe((await ctx.fs.resolve(join(root, 'a.txt'))).targetKey)
+    await ctx.fs.editText(alias, { oldString: 'first', newString: 'second', replaceAll: false }, { version: created.version })
+    await expect(ctx.fs.writeText(alias, 'third', { kind: 'replaceIfVersion', version: created.version })).rejects.toMatchObject({ code: 'FS_STALE_VERSION' })
+    expect((await ctx.fs.lstat('@test/a.txt'))?.type).toBe('file')
+  })
+  it('removes a caller registration on context unload and deduplicates shared resolvers', async () => {
+    const a = ctx.plugin({ inject: ['fs'], apply(scope) { scope.fs.registerPathAlias(resolver) } }); await a
+    const b = ctx.plugin({ inject: ['fs'], apply(scope) { scope.fs.registerPathAlias(resolver) } }); await b
+    await a.dispose()
+    expect((await ctx.fs.normalizePathAlias('@test/a.txt', { cwd: dir })).path).toBe(join(root, 'a.txt'))
+    await b.dispose()
+    expect((await ctx.fs.normalizePathAlias('@test/a.txt')).path).toBe('@test/a.txt')
+  })
+  it('rejects overlapping namespaces instead of depending on load order', async () => {
+    const stop = ctx.fs.registerPathAlias(resolver)
+    const other = ctx.fs.registerPathAlias(path => path.startsWith('@test/') ? { path: root } : undefined)
+    await expect(ctx.fs.resolve('@test/a')).rejects.toThrow('Multiple filesystem aliases')
+    other()
+    expect((await ctx.fs.resolve('@test/a')).displayPath).toBe(join(root, 'a'))
+    stop(); stop()
+  })
+  it('normalizes only once and propagates cancellation before alias work', async () => {
+    let calls = 0
+    ctx.fs.registerPathAlias(path => { calls++; return path === '@a' ? { path: '@b' } : undefined })
+    expect((await ctx.fs.normalizePathAlias('@a')).path).toBe('@b')
+    expect(calls).toBe(1)
+    const aborted = new AbortController(); aborted.abort()
+    await expect(ctx.fs.normalizePathAlias('@a', { signal: aborted.signal })).rejects.toThrow()
+    expect(calls).toBe(1)
+  })
+  it('preserves lstat final-link semantics but rejects escaped canonical identities', async () => {
+    ctx.fs.registerPathAlias(resolver)
+    const outside = join(dir, 'outside'); await mkdir(outside); await writeFile(join(outside, 'x'), 'secret')
+    await symlink(outside, join(root, 'link'), process.platform === 'win32' ? 'junction' : 'dir')
+    expect((await ctx.fs.lstat('@test/link'))?.type).toBe('symlink')
+    await expect(ctx.fs.resolve('@test/link/x')).rejects.toMatchObject({ code: 'FS_PERMISSION_DENIED' })
+    await expect(ctx.fs.lstat('@test/link/x')).rejects.toMatchObject({ code: 'FS_PERMISSION_DENIED' })
+  })
+})
